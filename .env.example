# =============================================================================
# Aperture — example environment file
# -----------------------------------------------------------------------------
# Copy to `.env` and adjust:   cp .env.example .env
#
# NOTE (Day 1): every value below is for LOCAL infrastructure that runs in
# Docker Compose on your own machine. No third-party API keys, cloud accounts
# or paid credentials are required for anything implemented so far. If a later
# milestone genuinely needs an external credential, it will be added here as a
# named, empty variable and you will be asked to fill it in.
# =============================================================================

# ---- Application ------------------------------------------------------------
APERTURE_ENV=local
SHOP_HOST=0.0.0.0
SHOP_PORT=8000
SHOP_LOG_LEVEL=INFO
# json  -> one JSON object per line (what the collector/analysis tooling expects)
# console -> human-readable, for local debugging
SHOP_LOG_FORMAT=json

# ---- PostgreSQL (application database, from docker-compose.yml) -------------
POSTGRES_HOST=localhost
# 5433 on purpose: avoids colliding with a PostgreSQL you may already run on 5432
POSTGRES_PORT=5433
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop_local_dev_password

# Full SQLAlchemy URL. If unset, it is assembled from the POSTGRES_* values above.
DATABASE_URL=postgresql+asyncpg://shop:shop_local_dev_password@localhost:5433/shop

# ---- Connection pool --------------------------------------------------------
# Planted pathology P5 (pool saturation) is created by lowering DB_POOL_SIZE
# while raising load-test concurrency. The healthy default is a sane pool.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_S=30
DB_ECHO_SQL=false

# ---- Seeding ----------------------------------------------------------------
# Profiles: tiny | small | medium | large   (see sample-shop/shop/seed/profiles.py)
SEED_PROFILE=small
SEED_RANDOM_SEED=1337

# =============================================================================
# Reserved for later milestones — NOT used by any code that exists today.
# Listed here so the configuration surface is visible up front; they are
# deliberately left commented out rather than faked.
# =============================================================================
# APERTURE_COLLECTOR_ENDPOINT=localhost:4317      # Week 1 Day 4-5 (OTLP/gRPC)
# APERTURE_SDK_ENABLED=false                      # Week 1 Day 2
# CLICKHOUSE_HOST=localhost                       # Week 1 Day 6
# CLICKHOUSE_PORT=9000
# CLICKHOUSE_DB=aperture
# SHADOW_POSTGRES_PORT=5434                       # Week 3 Day 15
