# =============================================================================
# Aperture — example environment file
# -----------------------------------------------------------------------------
# Copy to `.env` and adjust:   cp .env.example .env
#
# NOTE (Day 1): every value below is for LOCAL infrastructure that runs in
# Docker Compose on your own machine. No third-party API keys, cloud accounts
# or paid credentials are required for anything implemented so far. If a later
# milestone genuinely needs an external credential, it will be added here as a
# named, empty variable and you will be asked to fill it in.
# =============================================================================

# ---- Application ------------------------------------------------------------
APERTURE_ENV=local
SHOP_HOST=0.0.0.0
SHOP_PORT=8000
SHOP_LOG_LEVEL=INFO
# json  -> one JSON object per line (what the collector/analysis tooling expects)
# console -> human-readable, for local debugging
SHOP_LOG_FORMAT=json

# ---- PostgreSQL (application database, from docker-compose.yml) -------------
POSTGRES_HOST=localhost
# 5433 on purpose: avoids colliding with a PostgreSQL you may already run on 5432
POSTGRES_PORT=5433
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop_local_dev_password

# Full SQLAlchemy URL. If unset, it is assembled from the POSTGRES_* values above.
DATABASE_URL=postgresql+asyncpg://shop:shop_local_dev_password@localhost:5433/shop

# ---- Connection pool --------------------------------------------------------
# Planted pathology P5 (pool saturation) is created by lowering DB_POOL_SIZE
# while raising load-test concurrency. The healthy default is a sane pool.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_S=30
DB_ECHO_SQL=false

# ---- Seeding ----------------------------------------------------------------
# Profiles: tiny | small | medium | large   (see sample-shop/shop/seed/profiles.py)
SEED_PROFILE=small
SEED_RANDOM_SEED=1337

# =============================================================================
# Aperture SDK (sdk/aperture) — in-process instrumentation
# -----------------------------------------------------------------------------
# Off by default, and sample-shop behaves identically either way. Turning it on
# adds one ASGI middleware plus class-level hooks on SQLAlchemy and httpx.
# =============================================================================
APERTURE_SDK_ENABLED=false

# Where to send spans (OTLP over gRPC). Nothing has to be listening: if the
# collector is unreachable the application is unaffected, spans are dropped,
# and the drop counters go up.
APERTURE_COLLECTOR_ENDPOINT=localhost:4317
APERTURE_COLLECTOR_INSECURE=true

# Bounded buffering. This is design constraint C3: the ring never grows, and
# on overflow the newest span is dropped and counted.
APERTURE_BUFFER_CAPACITY=8192
APERTURE_EXPORT_BATCH_SIZE=512
APERTURE_EXPORT_INTERVAL_MS=1000
APERTURE_EXPORT_TIMEOUT_S=5
APERTURE_SHUTDOWN_TIMEOUT_S=3

# Capture detail.
APERTURE_CAPTURE_DB_STATEMENT=true
APERTURE_MAX_STATEMENT_CHARS=4096
APERTURE_CAPTURE_CODE_LOCATION=true
# Memoise the call site per SQL fingerprint. Off by default: it saves about
# 1.4 us per query and costs correctness when two call sites issue identical
# SQL, which is exactly the case on the product page. See sdk/README.md.
APERTURE_CODE_LOCATION_CACHE=false
# Per-trace span ceiling, so one runaway loop cannot produce an endless trace.
APERTURE_MAX_SPANS_PER_TRACE=2048

# 1.0 on purpose. Head sampling throws away the rare slow request, which is the
# one worth having; sampling is the collector's job, where the whole trace is
# available to decide on (DESIGN.md 7.2).
APERTURE_HEAD_SAMPLE_RATE=1.0

# Serve the SDK's own counters (including every drop counter) at this exact
# path. Empty means the endpoint does not exist. Handy locally; think before
# exposing it publicly.
#
# WINDOWS / GIT BASH: a value starting with "/" is rewritten by MSYS path
# conversion into something like C:/Program Files/Git/aperture/stats. Prefix
# the command with MSYS_NO_PATHCONV=1, or set the value from PowerShell.
APERTURE_STATS_PATH=

# Optional. Directories to treat as application code when capturing the call
# site of a query. Empty means "anything that is not the SDK, the standard
# library, or site-packages", which is right for a normal layout.
APERTURE_APP_PATH_PREFIXES=

# =============================================================================
# Reserved for later milestones — NOT used by any code that exists today.
# =============================================================================
# CLICKHOUSE_HOST=localhost                       # Week 1 Day 6
# CLICKHOUSE_PORT=9000
# CLICKHOUSE_DB=aperture
# SHADOW_POSTGRES_PORT=5434                       # Week 3 Day 15
